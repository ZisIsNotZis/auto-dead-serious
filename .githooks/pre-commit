#!/bin/sh
# The law lives in the agent-policy submodule; this refuses a commit whose view no longer
# matches its source, and says so when the submodule is not initialised.
set -e
cd "$(git rev-parse --show-toplevel)"
test -f agent-policy/render_policy.py || { echo "agent-policy submodule missing: git submodule update --init agent-policy" >&2; exit 1; }
exec python3 agent-policy/render_policy.py --check
