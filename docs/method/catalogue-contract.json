{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:catalogue:wp2-contract-v1",
  "title": "Catalogue WP2 investigator handoff",
  "description": "WP2 source assessment output. This JSON Schema validates handoff shape; scripts/catalogue.py also checks cross-field constraints, pinned-source coverage and lane membership.",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": 1
    },
    "lane": {
      "$ref": "#/$defs/text"
    },
    "root_source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "assessments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assessment"
      },
      "minItems": 1
    }
  },
  "required": [
    "contract_version",
    "lane",
    "root_source_revision",
    "assessments"
  ],
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        {
          "const": "unknown"
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/text"
      },
      "uniqueItems": true
    },
    "rating": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "estimated"
            },
            "estimate": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "plausible_range": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              "minItems": 2,
              "maxItems": 2
            },
            "rationale": {
              "$ref": "#/$defs/text"
            },
            "evidence_refs": {
              "$ref": "#/$defs/evidence_refs"
            }
          },
          "required": [
            "status",
            "estimate",
            "plausible_range",
            "rationale",
            "evidence_refs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "unknown"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "feasibility": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "range"
            },
            "probability_range": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 2,
              "maxItems": 2
            },
            "constraints": {
              "$ref": "#/$defs/text"
            },
            "horizon": {
              "$ref": "#/$defs/text"
            },
            "rationale": {
              "$ref": "#/$defs/text"
            },
            "evidence_refs": {
              "$ref": "#/$defs/evidence_refs"
            }
          },
          "required": [
            "status",
            "probability_range",
            "constraints",
            "horizon",
            "rationale",
            "evidence_refs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "unknown"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "provenance": {
          "enum": [
            "owner_testimony",
            "independent_observation",
            "agent_inference"
          ]
        },
        "claim": {
          "$ref": "#/$defs/text"
        },
        "source": {
          "$ref": "#/$defs/text"
        },
        "locator": {
          "$ref": "#/$defs/text"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "id",
        "provenance",
        "claim",
        "source",
        "locator",
        "revision"
      ],
      "additionalProperties": false
    },
    "effort": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "described"
            },
            "quantity": {
              "$ref": "#/$defs/text"
            },
            "source": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "status",
            "quantity",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "unknown"
            },
            "reason": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "status",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "project_judgements": {
      "type": "object",
      "properties": {
        "current_product_value": {
          "$ref": "#/$defs/rating"
        },
        "future_product_value": {
          "$ref": "#/$defs/rating"
        },
        "technical_feasibility": {
          "$ref": "#/$defs/feasibility"
        },
        "delivery_feasibility": {
          "$ref": "#/$defs/feasibility"
        }
      },
      "required": [
        "current_product_value",
        "future_product_value",
        "technical_feasibility",
        "delivery_feasibility"
      ],
      "additionalProperties": false
    },
    "contribution_judgements": {
      "type": "object",
      "properties": {
        "non_obviousness": {
          "$ref": "#/$defs/rating"
        },
        "depth_of_thought": {
          "$ref": "#/$defs/rating"
        },
        "transferability": {
          "$ref": "#/$defs/rating"
        },
        "current_contribution_value": {
          "$ref": "#/$defs/rating"
        },
        "future_contribution_value": {
          "$ref": "#/$defs/rating"
        }
      },
      "required": [
        "non_obviousness",
        "depth_of_thought",
        "transferability",
        "current_contribution_value",
        "future_contribution_value"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "description": {
          "$ref": "#/$defs/text"
        },
        "intended_scope": {
          "$ref": "#/$defs/text"
        },
        "judgements": {
          "$ref": "#/$defs/project_judgements"
        },
        "inside_value_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "description",
        "intended_scope",
        "judgements",
        "inside_value_refs"
      ],
      "additionalProperties": false
    },
    "contribution": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": [
            "transferable_practice_insight",
            "internal_module",
            "output"
          ]
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "reuse_scope": {
          "$ref": "#/$defs/text"
        },
        "judgements": {
          "$ref": "#/$defs/contribution_judgements"
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "reuse_scope",
        "judgements"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "maturity": {
          "enum": [
            "idea",
            "partial",
            "usable",
            "complete",
            "unknown"
          ]
        },
        "evidence_strength": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "audience": {
          "$ref": "#/$defs/text"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "delivery_form": {
          "$ref": "#/$defs/text"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "reuse_extraction_burden": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "maturity",
        "evidence_strength",
        "audience",
        "tags",
        "delivery_form",
        "requirements",
        "reuse_extraction_burden"
      ],
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/text"
        },
        "source_pin": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "project": {
          "$ref": "#/$defs/project"
        },
        "contributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contribution"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "effort": {
          "type": "object",
          "properties": {
            "human": {
              "$ref": "#/$defs/effort"
            },
            "ai": {
              "$ref": "#/$defs/effort"
            }
          },
          "required": [
            "human",
            "ai"
          ],
          "additionalProperties": false
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "next_decisive_step": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "path",
        "source_pin",
        "project",
        "contributions",
        "evidence",
        "effort",
        "metadata",
        "limitations",
        "next_decisive_step"
      ],
      "additionalProperties": false
    }
  },
