        "owner_testimony",
        "independent_observation",
        "agent_inference"
      ],
      "effort": "Human and AI effort are separate descriptions with source provenance or explicit unknown. Never infer effort from Git history, file counts, commits or elapsed checkout age.",
      "inside_value": "Project inside_value_refs cite contribution ids of kind transferable_practice_insight; do not store independent project-level contribution ratings.",
      "aggregation": "No total, mean, average, weighted score, or artificial tie-break is allowed. Preserve genuine ties and unknowns."
